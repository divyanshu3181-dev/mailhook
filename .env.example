# ===== Server =====
API_PORT=3000                           # Railway/most PaaS inject PORT — honored automatically over this
API_HOST=0.0.0.0
API_KEY=change-me-to-a-random-string
BASE_URL=http://localhost:3000          # In prod set to your public URL, e.g. https://mailhook.up.railway.app

# ===== Database (Supabase / Postgres) =====
# Run supabase/migrations/0001_mailhook_schema.sql in your project first.
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the SERVICE ROLE key (bypasses RLS) — NOT the anon key.
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# ===== Encryption =====
# REQUIRED. 64 hex chars (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Credentials are stored in a shared database — if this is lost or changed,
# all stored OAuth tokens and IMAP passwords become unreadable.
ENCRYPTION_KEY=

# ===== Google OAuth (for Gmail) =====
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Microsoft OAuth (for Outlook) =====
# Create at https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ===== IMAP Defaults =====
IMAP_IDLE_TIMEOUT=300000                # 5 min — imapflow re-issues IDLE before this
MAX_RECONNECT_ATTEMPTS=10               # only used when IMAP_NEVER_GIVE_UP=0
RECONNECT_MAX_DELAY=300000              # max backoff between reconnects: 5 min
IMAP_NEVER_GIVE_UP=1                    # 1 (default) = retry forever, never auto-deactivate an account
IMAP_KEEPALIVE_INTERVAL=60000           # ms between NOOP keepalives that detect dead sockets

# ===== Forwarder =====
WEBHOOK_TIMEOUT=30000                   # 30s timeout for webhook POST
MAX_RETRY_ATTEMPTS=4
FORWARDER_CONCURRENCY=10                # max concurrent webhook deliveries
MAX_ATTACHMENT_SIZE=10485760            # 10MB — skip base64 encoding above this

# ===== Logging =====
LOG_LEVEL=info
LOG_RETENTION_DAYS=30                   # auto-purge delivery_log older than this

# ===== Development =====
NODE_ENV=development
